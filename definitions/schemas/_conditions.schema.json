{
  "$id": "shared/conditions.schema.json",
  "type": "array",
  "title": "Conditions",
  "item_label": "Condition",
  "item_fields": [
    { "name": "field", "label": "Field", "type": "text", "required": true, "placeholder": "customer.country" },
    {
      "name": "operator",
      "label": "Operator",
      "type": "select",
      "required": true,
      "default": "equals",
      "options": [
        { "label": "equals", "value": "equals" },
        { "label": "not equals", "value": "not_equals" },
        { "label": "contains", "value": "contains" },
        { "label": "not contains", "value": "not_contains" },
        { "label": "greater than", "value": "greater_than" },
        { "label": "less than", "value": "less_than" },
        { "label": "greater or equal", "value": "greater_or_equal" },
        { "label": "less or equal", "value": "less_or_equal" },
        { "label": "exists", "value": "exists" },
        { "label": "not exists", "value": "not_exists" }
      ]
    },
    { "name": "value", "label": "Value", "type": "text" }
  ]
}
