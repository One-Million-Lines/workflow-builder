{
  "type": "object",
  "title": "API request",
  "fields": [
    {
      "name": "_info",
      "type": "info",
      "text": "This workflow is triggered programmatically via the API. Configure exit events below to stop the workflow when a user performs a specific action."
    },
    { "name": "_divider_exit", "type": "divider", "label": "Exit triggers" },
    {
      "name": "exit_events",
      "label": "Events that stop the workflow",
      "type": "repeater",
      "max_items": 3,
      "add_label": "Add exit event",
      "item_fields": [
        {
          "name": "event", "label": "Event name", "type": "select", "required": true,
          "options_source": "events", "placeholder": "Choose event"
        },
        {
          "name": "conditions",
          "label": "Conditions",
          "type": "repeater",
          "add_label": "Add condition",
          "item_fields": [
            {
              "name": "field", "label": "Field", "type": "select", "required": true,
              "options_source": "event_fields", "depends_on": ["event"],
              "placeholder": "Choose field"
            },
            {
              "name": "operator", "label": "Operator", "type": "select", "default": "equals",
              "options": [
                { "label": "equals", "value": "equals" },
                { "label": "not equals", "value": "not_equals" },
                { "label": "contains", "value": "contains" },
                { "label": "greater than", "value": "greater_than" },
                { "label": "less than", "value": "less_than" }
              ]
            },
            { "name": "value", "label": "Value", "type": "text" }
          ]
        }
      ]
    }
  ]
}
