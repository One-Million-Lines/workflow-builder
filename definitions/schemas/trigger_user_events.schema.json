              "options": [
                { "label": "equals", "value": "equals" },
                { "label": "not equals", "value": "not_equals" },
                { "label": "contains", "value": "contains" },
                { "label": "greater than", "value": "greater_than" },
                { "label": "less than", "value": "less_than" }
              ]
            },
            { "name": "value", "label": "Value", "type": "text" }
          ]
        }
      ]
    },
